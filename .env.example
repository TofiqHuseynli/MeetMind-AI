# Copy to .env.local (git ignores *.local) and fill in. Vite exposes only VITE_* to the browser.

# Browser: Supabase project URL and publishable key (Project Settings -> API Keys).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server only, read by the Vercel Functions in api/. Never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
